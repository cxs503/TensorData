{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tensordata/schemas/dtmb5415/train-ready.schema.json",
  "title": "DTMB 5415 design-space benchmark: surrogate-training table (X=27 design variables, y=Cw/az/xi5)",
  "type": "object",
  "required": [
    "config_index",
    "X",
    "y"
  ],
  "properties": {
    "config_index": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9000,
      "description": "column index in DTMB5415-database.mat; 0 = baseline DTMB 5415 hull"
    },
    "X": {
      "type": "array",
      "minItems": 27,
      "maxItems": 27,
      "items": {
        "type": "number",
        "minimum": -1.05,
        "maximum": 1.05
      },
      "description": "normalized design variables u1..u27 in [-1,1]"
    },
    "y": {
      "type": "object",
      "required": [
        "Cw",
        "az",
        "xi5"
      ],
      "properties": {
        "Cw": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {
            "type": "number"
          },
          "description": "wave resistance coefficient at Fr=0.25,0.33,0.41 (model scale Lpp=5.720 m, WARP)"
        },
        "az": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {
            "type": "number"
          },
          "description": "RMS vertical acceleration at bridge, full scale (SMP)"
        },
        "xi5": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {
            "type": "number"
          },
          "description": "RMS pitch, full scale (SMP)"
        }
      }
    },
    "geometry": {
      "type": "object",
      "description": "optional 2,250-point hull surface (full scale, half hull y>=0)",
      "properties": {
        "points": {
          "type": "array",
          "minItems": 2250,
          "maxItems": 2250,
          "items": {
            "type": "array",
            "minItems": 3,
            "maxItems": 3,
            "items": {
              "type": "number"
            }
          }
        }
      }
    },
    "qc": {
      "type": "object",
      "properties": {
        "gate_pass": {
          "type": "boolean"
        },
        "gate_reasons": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "measurement_limits": {
          "type": "object"
        }
      }
    }
  }
}